#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME     "options_controls_joystick"
#define GROUP_NAME    "grpOptionsControls"

// Controls Menu //
menuDef {
	name MENU_NAME
    visible     0
	fullscreen  0
	rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED

    onESC {
		close MENU_NAME ;
#ifdef FUI
		open main
#else
		open ingame_main
#endif // FUI
	}

// Window //
	WINDOW(_("OPTIONS"), 122)

	MAINBUTTON(1, _("MSGID_MENU_OPTION_GAME"), close MENU_NAME; open options_customise_game_player)
	MAINBUTTON(2, _("MSGID_MENU_OPTION_VIEW"), close MENU_NAME; open options_customise_hud_blood)
	MAINBUTTON_ACTIVE(3, _("MSGID_MENU_OPTION_CONTROLS"), close MENU_NAME; open options_controls_move)
	MAINBUTTON(4, _("MSGID_MENU_OPTION_SYSTEM"), close MENU_NAME; open options_system_graphics)

	WINDOW_BLANK(SIDEBAR_X, SIDEBAR_Y, SIDEBAR_W, SIDEBAR_H)

#define NUM_SUBMENUS 11
#define SIDEBAR_BTN_Y (SIDEBAR_Y + (SIDEBAR_H * 0.5) - (((NUM_SUBMENUS * SIDEBAR_BTN_H) + (MAIN_ELEMENT_MARGIN * (NUM_SUBMENUS - 1))) * 0.5))

	SIDEBUTTON(1, "MOVE", close MENU_NAME; open options_controls_move)
	SIDEBUTTON(2, "WEAPONS", close MENU_NAME; open options_controls_weapons)
	SIDEBUTTON(3, "POP-UPS", close MENU_NAME; open options_controls_popups)
	SIDEBUTTON(4, "CHAT", close MENU_NAME; open options_controls_chat)
	SIDEBUTTON(5, "MOUSE", close MENU_NAME; open options_controls_input)
	SIDEBUTTON(6, "MISCELLANEOUS", close MENU_NAME; open options_controls_miscellaneous)
	SIDEBUTTON(7, "FIRE-TEAMS", close MENU_NAME; open options_controls_fireteams)
	SIDEBUTTON_ACTIVE(8, "CONTROLLER", close MENU_NAME; open options_controls_joystick)
	SIDEBUTTON(9, "SHOUTCASTER", close MENU_NAME; open options_controls_shoutcaster)
	SIDEBUTTON(10, "SELECTION MENUS", close MENU_NAME; open options_controls_selection_menus)

	SUBWINDOW(OPTION_SUBW_X, OPTION_SUBW_Y, OPTION_SUBW_W, OPTION_SUBW_H, "CONTROLLER")

	// Laid out like the controller settings of console shooters. Buttons are bound in the
	// other tabs by pressing a controller button, like any key.
	MULTI(OPTION_ITEM_POS(1), _("Controller:"), .2, 8, "in_joystick", cvarFloatList { "Off" 0 "On" 1 }, _("Use a game controller (takes effect after vid_restart)"))
	MULTI(OPTION_ITEM_POS(2), _("Aim Response Curve:"), .2, 8, "pad_responseCurve", cvarFloatList { "Standard" 0 "Linear" 1 "Dynamic" 2 }, _("Standard: fine near the centre. Linear: direct. Dynamic: very fine near the centre, fast at the edge"))
	CVARFLOATLABEL(OPTION_ITEM_POS(3), "pad_sensitivity", .2, ITEM_ALIGN_RIGHT, $evalfloat(SLIDER_LABEL_X), 8)
	SLIDER(OPTION_ITEM_POS(3), _("Horizontal Stick Sensitivity:"), .2, 8, "pad_sensitivity" 6 1 20, _("How fast the right stick turns you left and right (1-20)"))
	CVARFLOATLABEL(OPTION_ITEM_POS(4), "pad_sensitivityY", .2, ITEM_ALIGN_RIGHT, $evalfloat(SLIDER_LABEL_X), 8)
	SLIDER(OPTION_ITEM_POS(4), _("Vertical Stick Sensitivity:"), .2, 8, "pad_sensitivityY" 6 1 20, _("How fast the right stick looks up and down (1-20)"))
	CVARFLOATLABEL(OPTION_ITEM_POS(5), "pad_adsMultiplier", .2, ITEM_ALIGN_RIGHT, $evalfloat(SLIDER_LABEL_X), 8)
	SLIDER(OPTION_ITEM_POS(5), _("ADS Sensitivity Multiplier:"), .2, 8, "pad_adsMultiplier" 1 0.1 3, _("Aiming speed while zoomed or scoped, on top of the zoom itself"))
	MULTI(OPTION_ITEM_POS(6), _("Invert Vertical Look:"), .2, 8, "pad_invertY", cvarFloatList { "Off" 0 "On" 1 }, _("Push the right stick up to look down"))
	MULTI(OPTION_ITEM_POS(7), _("Turn Boost:"), .2, 8, "pad_turnBoost", cvarFloatList { "Off" 0 "On" 1 }, _("Turn faster after holding the right stick at the edge"))
	CVARFLOATLABEL(OPTION_ITEM_POS(8), "pad_deadzoneLeft", .2, ITEM_ALIGN_RIGHT, $evalfloat(SLIDER_LABEL_X), 8)
	SLIDER(OPTION_ITEM_POS(8), _("Left Stick Deadzone:"), .2, 8, "pad_deadzoneLeft" 0.12 0 0.5, _("How far the left stick moves before you start walking"))
	CVARFLOATLABEL(OPTION_ITEM_POS(9), "pad_deadzoneRight", .2, ITEM_ALIGN_RIGHT, $evalfloat(SLIDER_LABEL_X), 8)
	SLIDER(OPTION_ITEM_POS(9), _("Right Stick Deadzone:"), .2, 8, "pad_deadzoneRight" 0.10 0 0.5, _("How far the right stick moves before you start turning. Lower it until the view drifts, then raise it a little"))
	MULTI(OPTION_ITEM_POS(10), _("Stick Aiming:"), .2, 8, "pad_aim", cvarFloatList { "On" 1 "Off" 0 }, _("Turn off to bind the sticks yourself"))

	BUTTON(OPTION_BUTTON_POS(12), _("DEFAULT BUTTON LAYOUT"), .24, 11, exec "padDefaultBinds")

#ifdef FUI
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME; open main)
#else
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME; open ingame_main)
#endif
	LOWERBUTTON(2, _("MSGID_MENU_OPTION_OPEN_HOME"), close MENU_NAME ; open options_homepath)


	LOWERBUTTON(3, _("MSGID_MENU_DEFAULT"), clearfocus; open options_controls_default)
}
